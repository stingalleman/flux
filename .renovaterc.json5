{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests",
    "abandonments:recommended",
    // "github>onedr0p/home-ops//.renovate/autoMerge.json5",
    // "github>onedr0p/home-ops//.renovate/changelogs.json5",
    // "github>onedr0p/home-ops//.renovate/customManagers.json5",
    // "github>onedr0p/home-ops//.renovate/grafanaDashboards.json5",
    // "github>onedr0p/home-ops//.renovate/groups.json5",
    // "github>onedr0p/home-ops//.renovate/labels.json5",
    // "github>onedr0p/home-ops//.renovate/overrides.json5",
    // "github>onedr0p/home-ops//.renovate/semanticCommits.json5",
    // ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Amsterdam)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/.vscode/**",
    "**/clusters/cluster.boem/old/**",
    "**/ansible/**",
  ],
  flux: {
    // managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
    managerFilePatterns: ["/\\.ya?ml$/"],
  },
  kubernetes: {
    // managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
    managerFilePatterns: ["/\\.ya?ml$/"],
  },
  packageRules: [
  {
    description: "Staged cert-manager upgrade path",
    matchManagers: ["flux"],
    matchDatasources: ["helm"],
    matchPackageNames: ["cert-manager"],
    allowedVersions: "<{{major}}.{{add minor 2}}.0",
    automerge: false,
  },
],
}
